{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "allowJs": false,
    "declaration": false,
    "incremental": false,
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "noEmit": false,
    "outDir": "dist",
    "plugins": [],
    "rootDir": ".",
    "sourceMap": true,
    "tsBuildInfoFile": "dist/.tsbuildinfo/backend.tsbuildinfo"
  },
  "include": ["backend/**/*.ts", "shared/**/*.ts"],
  "exclude": ["node_modules"]
}
