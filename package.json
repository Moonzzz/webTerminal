{
  "name": "webTerminal",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.0.0",
    "npm": ">=10.0.0"
  },
  "scripts": {
    "dev": "node --import tsx backend/server.ts",
    "test": "node --import tsx --test tests/*.test.ts",
    "build": "npm run typecheck && npm run build:frontend && npm run build:backend",
    "build:frontend": "next build frontend",
    "build:backend": "node -e \"require('node:fs').rmSync('dist/backend',{recursive:true,force:true})\" && tsc -p tsconfig.backend.json",
    "build:bundle": "node scripts/create-production-bundle.mjs",
    "start": "NODE_ENV=production node dist/backend/server.js",
    "docker:build": "scripts/build-docker-image.sh",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "next": "^16.2.9",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "ssh2": "^1.17.0",
    "ws": "^8.21.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@types/ssh2": "^1.15.5",
    "@types/ws": "^8.18.1",
    "@vercel/nft": "^0.30.4",
    "tsx": "^4.22.4",
    "typescript": "^5.9.3"
  },
  "overrides": {
    "postcss": "^8.5.10"
  }
}
